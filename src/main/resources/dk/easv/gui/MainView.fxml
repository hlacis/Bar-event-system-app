<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dk.easv.gui.MainController"
            styleClass="admin-root">

    <!-- LEFT SIDEBAR (FULL HEIGHT) -->
    <left>
        <VBox prefWidth="260"
              minWidth="260"
              maxWidth="260"
              styleClass="sidebar">
            <padding>
                <Insets top="22" right="18" bottom="18" left="18"/>
            </padding>

            <Label text="EASV Tickets" styleClass="sidebar-title"/>

            <Region prefHeight="22"/>

            <VBox spacing="10" styleClass="sidebar-nav">
                <fx:define>
                    <ToggleGroup fx:id="navGroup"/>
                </fx:define>

                <ToggleButton fx:id="usersBtn"
                              text="E.C. Management"
                              toggleGroup="$navGroup"
                              onAction="#showUsers"
                              styleClass="nav-button"/>

                <ToggleButton fx:id="assignBtn"
                              text="E.C. Assigning"
                              toggleGroup="$navGroup"
                              onAction="#showAssign"
                              styleClass="nav-button"/>

                <ToggleButton fx:id="eventsBtn"
                              text="Events"
                              toggleGroup="$navGroup"
                              onAction="#showEvents"
                              styleClass="nav-button"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="4"
                  alignment="BOTTOM_LEFT"
                  minHeight="72"
                  prefHeight="72"
                  style="-fx-padding: 0 0 8 0;">
                <Label fx:id="userNameLabel"
                       styleClass="sidebar-user-name"
                       wrapText="false"/>

                <Label fx:id="userRoleLabel"
                       styleClass="sidebar-user-role"
                       wrapText="false"/>
            </VBox>
        </VBox>
    </left>

    <!-- RIGHT SIDE (TOPBAR + CONTENT) -->
    <center>
        <BorderPane>

            <top>
                <HBox spacing="12" alignment="CENTER_LEFT" styleClass="topbar">
                    <padding>
                        <Insets top="14" right="18" bottom="14" left="28"/>
                    </padding>

                    <Label fx:id="panelTitleLabel" styleClass="topbar-title"/>

                    <Region HBox.hgrow="ALWAYS"
                            prefWidth="500"
                            minWidth="500"
                            maxWidth="500"/>

                    <Region HBox.hgrow="NEVER" prefWidth="120"/>
                    <Button text="Log Out"
                            onAction="#logout"
                            styleClass="secondary-button"
                            />
                </HBox>
            </top>

            <center>
                <StackPane fx:id="contentHost"
                           styleClass="content-host"
                           BorderPane.alignment="CENTER"/>
            </center>

        </BorderPane>
    </center>

</BorderPane>
