<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            hbarPolicy="NEVER"
            pannable="false"
            vbarPolicy="NEVER"
            style="-fx-background: transparent; -fx-background-color: transparent;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="dk.easv.gui.EventDetailsController">

    <content>
        <VBox fillWidth="true"
              maxWidth="1.7976931348623157E308"
              minWidth="0.0"
              spacing="20"
              styleClass="page">

            <Button text="Back"
                    onAction="#handleBack"
                    styleClass="secondary-button"
                    prefWidth="72"
                    minWidth="72"
                    maxWidth="72" />

            <HBox alignment="CENTER_LEFT" spacing="16">
                <Label fx:id="nameLabel"
                       styleClass="event-details-title"
                       maxWidth="1.7976931348623157E308"
                       minWidth="0.0"
                       HBox.hgrow="ALWAYS" />

                <Button fx:id="printTicketsButton"
                        text="Print Tickets"
                        styleClass="secondary-button"
                        prefWidth="145"
                        minWidth="145"
                        maxWidth="145"
                        prefHeight="46"
                        onAction="#handlePrintTickets" />

                <Button fx:id="editEventButton"
                        text="Edit"
                        onAction="#handleEdit"
                        styleClass="primary-button"
                        prefWidth="145"
                        minWidth="145"
                        maxWidth="145"
                        prefHeight="46" />
            </HBox>

            <VBox spacing="12" styleClass="card">
                <Label fx:id="timeLabel" styleClass="muted" />
                <Label fx:id="locationLabel" styleClass="muted" />
                <Label text="Information" styleClass="section-title" />
                <Label fx:id="notesLabel"
                       wrapText="true"
                       styleClass="card-subtext" />
            </VBox>

            <VBox maxWidth="1.7976931348623157E308"
                  minWidth="0.0"
                  spacing="12"
                  styleClass="card">

                <Label text="Ticket Types" styleClass="section-title" />

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <TextField fx:id="txtTicketName"
                               maxWidth="170"
                               minWidth="170"
                               prefWidth="170"
                               promptText="Name" />

                    <TextField fx:id="txtPrice"
                               maxWidth="120"
                               minWidth="120"
                               prefWidth="120"
                               promptText="Price" />

                    <TextField fx:id="txtQuantity"
                               maxWidth="120"
                               minWidth="120"
                               prefWidth="120"
                               promptText="Quantity" />

                    <TextField fx:id="txtNote"
                               maxWidth="190"
                               minWidth="190"
                               prefWidth="190"
                               promptText="Note (e.g. Free drink)" />

                    <Button fx:id="addTicketButton"
                            maxWidth="75"
                            minWidth="75"
                            prefWidth="75"
                            onAction="#handleAddTicketType"
                            styleClass="primary-button"
                            text="Add" />

                    <Button fx:id="editTicketButton"
                            maxWidth="75"
                            minWidth="75"
                            prefWidth="75"
                            onAction="#handleEditTicketType"
                            styleClass="secondary-button"
                            text="Edit" />

                    <Button fx:id="deleteTicketButton"
                            maxWidth="80"
                            minWidth="80"
                            prefWidth="80"
                            onAction="#handleDeleteTicketType"
                            styleClass="secondary-button"
                            text="Delete" />
                </HBox>

                <TableView fx:id="ticketTable"
                           maxHeight="180"
                           minHeight="180"
                           prefHeight="180">
                    <columns>
                        <TableColumn fx:id="colName" text="Name" prefWidth="160" />
                        <TableColumn fx:id="colPrice" text="Price" prefWidth="100" />
                        <TableColumn fx:id="colQuantity" text="Quantity" prefWidth="100" />
                        <TableColumn fx:id="colLeft" text="Left" prefWidth="100" />
                        <TableColumn fx:id="colNote" text="Note" prefWidth="524" />
                    </columns>
                </TableView>
            </VBox>

            <VBox maxWidth="1.7976931348623157E308"
                  minWidth="0.0"
                  spacing="12"
                  styleClass="card">

                <Label text="Vouchers" styleClass="section-title" />

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <TextField fx:id="txtVoucherName"
                               promptText="Name"
                               prefWidth="170"
                               minWidth="170"
                               maxWidth="170" />

                    <TextField fx:id="txtVoucherQuantity"
                               promptText="Quantity"
                               prefWidth="120"
                               minWidth="120"
                               maxWidth="120" />

                    <TextField fx:id="txtVoucherNote"
                               promptText="Note"
                               prefWidth="190"
                               minWidth="190"
                               maxWidth="190" />

                    <Button fx:id="addVoucherButton"
                            text="Add"
                            onAction="#handleAddVoucher"
                            styleClass="primary-button"
                            prefWidth="70"
                            minWidth="70"
                            maxWidth="70" />

                    <Button fx:id="editVoucherButton"
                            text="Edit"
                            onAction="#handleEditVoucher"
                            styleClass="secondary-button"
                            prefWidth="70"
                            minWidth="70"
                            maxWidth="70" />

                    <Button fx:id="deleteVoucherButton"
                            text="Delete"
                            onAction="#handleDeleteVoucher"
                            styleClass="secondary-button"
                            prefWidth="75"
                            minWidth="75"
                            maxWidth="75" />

                    <Button fx:id="printVouchersButton"
                            text="Print Vouchers"
                            onAction="#handlePrintVouchers"
                            styleClass="print-button" />
                </HBox>

                <TableView fx:id="voucherTable"
                           prefHeight="180"
                           minHeight="180"
                           maxHeight="180">
                    <columns>
                        <TableColumn fx:id="colVoucherName" text="Name" prefWidth="180" />
                        <TableColumn fx:id="colVoucherQuantity" text="Quantity" prefWidth="120" />
                        <TableColumn fx:id="colVoucherLeft" text="Left" prefWidth="120" />
                        <TableColumn fx:id="colVoucherNote" text="Note" prefWidth="584" />
                    </columns>
                </TableView>
            </VBox>

        </VBox>
    </content>
</ScrollPane>