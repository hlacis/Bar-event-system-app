<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox spacing="28" styleClass="page" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.gui.AssignCoordinatorController">

    <!-- LEFT COLUMN -->
    <VBox spacing="14" HBox.hgrow="ALWAYS">

        <Label styleClass="page-title" text="Assign Coordinators" />
        <Label styleClass="section-title" text="Events" />

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="users-scroll" VBox.vgrow="ALWAYS">

            <content>
                <VBox fx:id="cardContainer" spacing="16" styleClass="users-list">
                    <padding>
                        <Insets bottom="18" left="2" right="8" top="2" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </VBox>

    <!-- RIGHT COLUMN -->
    <VBox maxWidth="420" minWidth="300" prefWidth="380" spacing="14">
        <styleClass>
            <String fx:value="assign-form" />
        </styleClass>

        <padding>
            <Insets bottom="18" left="18" right="18" top="18" />
        </padding>

        <Label fx:id="rightTitleLabel" styleClass="section-title" text="Select Coordinators" />
        <Label fx:id="selectedEventLabel" styleClass="muted" text="Click an event on the left." />

        <VBox spacing="8">
            <Label styleClass="form-label" text="Available Coordinators" />

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" prefHeight="420" styleClass="users-scroll" vbarPolicy="AS_NEEDED">

                <content>
                    <VBox fx:id="coordinatorCheckboxContainer" spacing="10" styleClass="form-box">
                        <padding>
                            <Insets bottom="12" left="12" right="12" top="12" />
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>

        <Region VBox.vgrow="ALWAYS" />

        <HBox spacing="12">
            <Button onAction="#saveAssignments" text="Save">
                <styleClass>
                    <String fx:value="primary-button" />
                    <String fx:value="form-primary" />
                </styleClass>
            </Button>

            <Button onAction="#cancelSelection" text="Cancel">
                <styleClass>
                    <String fx:value="secondary-button" />
                    <String fx:value="form-secondary" />
                </styleClass>
            </Button>
        </HBox>

    </VBox>

</HBox>
