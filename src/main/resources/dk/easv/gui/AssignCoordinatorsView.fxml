<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>

<HBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dk.easv.gui.AssignCoordinatorController"
      spacing="28"
      styleClass="page">

    <!-- LEFT COLUMN -->
    <VBox spacing="14" HBox.hgrow="ALWAYS">

        <Label text="Assign Coordinators" styleClass="page-title"/>
        <Label text="Events" styleClass="section-title"/>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="users-scroll"
                    VBox.vgrow="ALWAYS">

            <content>
                <VBox fx:id="cardContainer" spacing="16" styleClass="users-list">
                    <padding>
                        <Insets top="2" right="8" bottom="18" left="2"/>
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </VBox>

    <!-- RIGHT COLUMN -->
    <VBox spacing="14" prefWidth="380" minWidth="300" maxWidth="420">
        <styleClass>
            <String fx:value="assign-form"/>
        </styleClass>

        <padding>
            <Insets top="18" right="18" bottom="18" left="18"/>
        </padding>

        <Label fx:id="rightTitleLabel" text="Select Coordinators" styleClass="section-title"/>
        <Label fx:id="selectedEventLabel" text="Click an event on the left." styleClass="muted"/>

        <VBox spacing="8">
            <Label text="Available Coordinators" styleClass="form-label"/>

            <ScrollPane fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="users-scroll"
                        prefHeight="420">

                <content>
                    <VBox fx:id="coordinatorCheckboxContainer" spacing="10" styleClass="form-box">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>
                    </VBox>
                </content>
            </ScrollPane>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox spacing="12">
            <Button text="Save" onAction="#saveAssignments">
                <styleClass>
                    <String fx:value="primary-button"/>
                    <String fx:value="form-primary"/>
                </styleClass>
            </Button>

            <Button text="Cancel" onAction="#cancelSelection">
                <styleClass>
                    <String fx:value="secondary-button"/>
                    <String fx:value="form-secondary"/>
                </styleClass>
            </Button>
        </HBox>

    </VBox>

</HBox>