<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="dk.easv.gui.EventCreatorController"
      spacing="14"
      styleClass="page">

    <Label fx:id="titleLabel" text="Create Event" styleClass="page-title"/>
    <Label text="Fill in the event details below." styleClass="page-subtitle"/>

    <VBox spacing="12" styleClass="card" maxWidth="560">
        <padding>
            <Insets top="20" right="20" bottom="20" left="20"/>
        </padding>

        <Label text="Event Name" styleClass="field-label"/>
        <TextField fx:id="nameField" promptText="Enter event name..." styleClass="search-input"/>

        <Label text="Start Date" styleClass="field-label"/>
        <DatePicker fx:id="startDatePicker"/>

        <Label text="End Date" styleClass="field-label"/>
        <DatePicker fx:id="endDatePicker"/>

        <Label text="Location" styleClass="field-label"/>
        <TextField fx:id="locationField" promptText="Enter location..." styleClass="search-input"/>

        <Label text="Notes" styleClass="field-label"/>
        <TextField fx:id="notesField" promptText="Enter notes..." styleClass="search-input"/>

        <HBox spacing="12">
            <Button fx:id="saveButton" text="Save Event" onAction="#saveEvent" styleClass="primary-button"/>
            <Button text="Cancel" onAction="#cancel" styleClass="secondary-button"/>
        </HBox>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>
</VBox>